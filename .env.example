# ── FiveAM CMS ────────────────────────────────────────────────
# Copy this file to ".env.local" for local development.
# On Vercel: Project → Settings → Environment Variables.

# Password for the /admin CMS login (choose something strong).
ADMIN_PASSWORD=

# Fine-grained GitHub Personal Access Token with "Contents: Read and write"
# permission scoped to the fiveamvision repository.
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

GITHUB_OWNER=fajarramadhani
GITHUB_REPO=fiveamvision
GITHUB_BRANCH=main
